{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalSlack",
  "version": "0.1.0",
  "identifier": "com.localslack.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalSlack",
        "width": 1180,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 620,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "libxcb1",
          "libx11-6",
          "libavahi-client3",
          "zenity"
        ],
        "recommends": ["avahi-daemon"]
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
