{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftShare",
  "version": "0.1.0",
  "identifier": "com.swiftshare.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SwiftShare",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libwebkit2gtk-4.0-37",
        "libappindicator3-1",
        "libavahi-client3",
        "libxcb1",
        "libx11-6",
        "zenity"
      ]
    }
  }
}
